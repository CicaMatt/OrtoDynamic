# Copy to `.env.local` to override the API base URL.
# Defaults to http://localhost:8000/api/v1 when unset.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# `/` for a domain or subdomain root; `/OrtoDynamic/` for the current GitHub
# Pages project site; `/management/` when installed below an existing website.
VITE_BASE_PATH=/
