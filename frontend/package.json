{
  "name": "ortodynamic-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check eslint.config.js vite.config.ts package.json tsconfig.json tsconfig.node.json tests src",
    "test": "vitest run",
