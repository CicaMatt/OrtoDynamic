# Example values for deployment/aruba/compose.yaml.
# Enter the real values in Coolify. Do not create or commit deployment/aruba/.env.

# Match this image to the source server's tested MySQL major version before the
# first import. Pin an exact patch tag or digest after the migration rehearsal.
MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=ortodynamic
MYSQL_USER=ortodynamic_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_ALLOWED_HOSTS=api-management.example.it
DJANGO_CORS_ALLOWED_ORIGINS=https://management.example.it
DJANGO_TIME_ZONE=Europe/Rome
DJANGO_LOG_LEVEL=INFO
DJANGO_AUTH_TOKEN_TTL_SECONDS=43200
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_DB_CONN_MAX_AGE=60

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Public build coordinates. These values are intentionally embedded in the
# static frontend bundle and are not secrets.
VITE_API_BASE_URL=https://api-management.example.it/api/v1
VITE_BASE_PATH=/
